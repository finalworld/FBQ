{
  "version": 8,
  "name": "Frasse Dark Grass",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#477f3f" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "wood", "#356d37",
          "grass", "#4f9146",
          "farmland", "#568e47",
          "wetland", "#477f46",
          "sand", "#668c4d",
          "#477f3f"
        ],
        "fill-opacity": 0.95
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#4b8842", "fill-opacity": 0.92 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "residential", "#56864c",
          "agriculture", "#5b914a",
          "cemetery", "#416f40",
          "industrial", "#527f49",
          "commercial", "#527f49",
          "#4d8743"
        ],
        "fill-opacity": 0.88
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#78a9e9", "fill-opacity": 1.0 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": { "line-color": "#76aee5", "line-width": 1.6 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d1cdc7",
        "fill-outline-color": "#a8a49e",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#bf9560",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 8, 1.2, 12, 2.7, 16, 8.5, 20, 22]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": [
          "match", ["get", "class"],
          "motorway", "#f4b868",
          "trunk", "#f4bd73",
          "primary", "#ffd28a",
          "secondary", "#f7ddb0",
          "tertiary", "#efe5ce",
          "#f1ede5"
        ],
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 8, 0.7, 12, 1.8, 16, 6.3, 20, 18]
      }
    },
    {
      "id": "paths",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["path", "track", "pedestrian"], true, false],
      "minzoom": 11,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f4f1e7",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.7, 15, 2.0, 18, 4.5],
        "line-dasharray": [1.2, 1.0]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "filter": ["==", ["geometry-type"], "LineString"],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 280,
        "text-field": ["coalesce", ["get", "name:sv"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 15, 19, 18],
        "text-max-angle": 35
      },
      "paint": {
        "text-color": "#30291f",
        "text-halo-color": "rgba(255,247,225,0.88)",
        "text-halo-width": 1.4
      }
    }
  ]
}
