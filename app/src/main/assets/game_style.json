{
  "version": 8,
  "name": "Frasse Pixel RPG",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#496F35" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "wood", "#284E2D",
          "grass", "#567D39",
          "farmland", "#718446",
          "wetland", "#365E4B",
          "sand", "#BFA36A",
          "#496F35"
        ],
        "fill-opacity": 0.95
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#4E7836", "fill-opacity": 0.96 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "residential", "#67784B",
          "agriculture", "#718446",
          "cemetery", "#365A38",
          "industrial", "#62664D",
          "commercial", "#6B674D",
          "#52723C"
        ],
        "fill-opacity": 0.88
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#2F7895", "fill-opacity": 1.0 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": { "line-color": "#3E90AA", "line-width": 2.0 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#C6B58F",
        "fill-outline-color": "#594C37",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#6F5130",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 8, 1.2, 12, 2.7, 16, 8.5, 20, 22]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": [
          "match", ["get", "class"],
          "motorway", "#D69A50",
          "trunk", "#DEA85F",
          "primary", "#E8C47F",
          "secondary", "#E7D09D",
          "tertiary", "#E4D8B7",
          "#E9DFC6"
        ],
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 8, 0.7, 12, 1.8, 16, 6.3, 20, 18]
      }
    },
    {
      "id": "paths",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["path", "track", "pedestrian"], true, false],
      "minzoom": 11,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#F0DFB4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.7, 15, 2.0, 18, 4.5],
        "line-dasharray": [1.2, 1.0]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "filter": ["==", ["geometry-type"], "LineString"],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 280,
        "text-field": ["coalesce", ["get", "name:sv"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 15, 19, 18],
        "text-max-angle": 35
      },
      "paint": {
        "text-color": "#2A241B",
        "text-halo-color": "rgba(255,232,190,0.94)",
        "text-halo-width": 1.4
      }
    }
  ]
}
